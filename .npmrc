# This is an Angular 9-era dependency tree; several devDependencies declare
# peer ranges (codelyzer -> tslint, etc.) that don't line up exactly with
# what's actually installed. npm 6 (this project's original tooling)
# tolerated that as a warning; npm 7+ treats it as a hard install failure by
# default. legacy-peer-deps restores the old, permissive behavior so
# `npm install` works the same way regardless of which npm a given host
# bundles with its Node version.
legacy-peer-deps=true
